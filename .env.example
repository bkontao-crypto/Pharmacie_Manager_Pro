# --- Base de données ---
# DATABASE_URL : rôle de l'APPLICATION (non superuser, sinon la RLS est contournée).
# MIGRATE_DATABASE_URL : rôle PROPRIÉTAIRE, utilisé seulement par `npm run migrate` (à défaut, DATABASE_URL).
DATABASE_URL=postgresql://pmp_app:motdepasse@localhost:5432/pharmacie_db
MIGRATE_DATABASE_URL=postgresql://pmp_owner:motdepasse@localhost:5432/pharmacie_db

# --- Docker Compose uniquement (mots de passe ALPHANUMÉRIQUES, ex. : openssl rand -hex 16) ---
POSTGRES_PASSWORD=remplacer
PMP_OWNER_PASSWORD=remplacer
PMP_APP_PASSWORD=remplacer

# --- Secrets (générer : openssl rand -hex 32) ---
JWT_SECRET=remplacer_par_une_valeur_aleatoire_de_64_caracteres_minimum
ENCRYPTION_KEY=remplacer_par_64_caracteres_hexadecimaux

# --- Serveur ---
PORT=3000
NODE_ENV=development
# Derrière un reverse proxy HTTPS (Nginx, Caddy…) : TRUST_PROXY=1
TRUST_PROXY=0
# Origines autorisées en CORS, séparées par des virgules (vide = même origine uniquement)
CORS_ORIGINS=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- Compte Superadmin initial (utilisé par `npm run seed`) ---
SUPERADMIN_EMAIL=superadmin@exemple.ml
SUPERADMIN_PASSWORD=ChangezMoi2026

# --- Sauvegardes chiffrées (npm run backup) ---
# Clé DIFFÉRENTE de ENCRYPTION_KEY (openssl rand -hex 32), à conserver HORS du serveur : sans elle, aucune restauration possible.
BACKUP_ENCRYPTION_KEY=remplacer_par_64_caracteres_hexadecimaux_differents
BACKUP_DIR=./backups
BACKUP_KEEP=14
# Copie hors serveur (optionnel mais fortement recommandé), le fichier est dans $BACKUP_FILE. Exemple :
# BACKUP_UPLOAD_CMD=rclone copy "$BACKUP_FILE" remote:pmp-backups/
